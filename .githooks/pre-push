#!/usr/bin/env bash
# Lint pushed commit messages (conventional commits), then run any local
# pre-push hook, e.g. the one `rh install-hook` writes to .git/hooks/.
set -euo pipefail
[ -n "${CI:-}" ] && exit 0
zero=0000000000000000000000000000000000000000
input=$(cat)
while read -r _ local_sha _ remote_sha; do
  if [ -z "${local_sha:-}" ] || [ "$local_sha" = "$zero" ]; then continue; fi  # deletion
  from=$remote_sha
  if [ "$from" = "$zero" ] || ! git cat-file -e "$from^{commit}" 2>/dev/null; then
    from=$(git merge-base origin/main "$local_sha")  # new branch / unknown remote tip
  fi
  pnpm exec commitlint --from "$from" --to "$local_sha"
done <<< "$input"
local_hook="$(git rev-parse --git-common-dir)/hooks/pre-push"
if [ -x "$local_hook" ]; then printf '%s\n' "$input" | "$local_hook" "$@"; fi
